# ==========================================
# Application
# ==========================================

APP_NAME=mediclaim-adjudication
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

HOST=0.0.0.0
PORT=8000


# ==========================================
# LLM
# ==========================================

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini


# ==========================================
# LangSmith
# ==========================================

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=mediclaim-adjudication


# ==========================================
# Vector Store
# ==========================================

VECTOR_STORE=faiss
VECTOR_STORE_PATH=./vectorstore


# ==========================================
# Mem0
# ==========================================

MEM0_API_KEY=your_mem0_api_key


# ==========================================
# Database
# ==========================================

DATABASE_URL=sqlite:///./mediclaim.db


# ==========================================
# MCP
# ==========================================

MCP_SERVER_URL=http://localhost:9000


# ==========================================
# Security
# ==========================================

TOKEN_ENCRYPTION_KEY=replace_with_secure_key


# ==========================================
# File Storage
# ==========================================

POLICY_DATA_PATH=./data/policies
CLAIM_DATA_PATH=./data/sample_claims
MEDICAL_DOCUMENT_PATH=./data/medical_documents